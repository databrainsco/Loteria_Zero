# Loteria Zero - Flipper Zero FAP manifest
# See: documentation/AppManifests.md in flipperzero-firmware

App(
    appid="loteria_zero",
    name="Loteria Zero",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="loteria_zero_app",
    stack_size=4 * 1024,
    fap_version=(1, 0),
    fap_category="Games",
    fap_icon="loteria_zero.png",
    fap_description="Mexican Loteria caller for Flipper Zero with 54 cards and original rhymes.",
    fap_author="databrainsco",
    fap_weburl="https://github.com/databrainsco/Loteria_Zero",
    fap_icon_assets="images",
    fap_file_assets="files",
    sources=[
        "src/*.c",
        "src/scenes/*.c",
    ],
)
